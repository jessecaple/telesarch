{
  "name": "@telesarch/cli",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    }
  },
  "scripts": {
    "build": "tsc --project tsconfig.lib.json",
    "lint": "eslint scripts src test",
    "package:npm": "tsx scripts/build-npm-package.ts",
    "package:npm:check": "pnpm package:npm && tsx scripts/check-npm-package.ts",
    "test": "vitest run",
    "typecheck": "tsc --project tsconfig.lib.json --noEmit"
  },
  "nx": {
    "tags": [
      "type:tool"
    ]
  },
  "dependencies": {
    "@modelcontextprotocol/server": "2.0.0",
    "@telesarch/engine": "workspace:*",
    "@telesarch/role-mcp": "workspace:*",
    "@telesarch/session-mcp": "workspace:*",
    "@telesarch/storybook": "workspace:*"
  },
  "devDependencies": {
    "esbuild": "0.28.2"
  }
}
