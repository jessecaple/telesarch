{
  "name": "big-plan",
  "version": "0.0.0",
  "description": "Host-only DeepSeek Harness plugin for durable delivery coordination",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "dist/**/*.js",
    "dist/**/*.d.ts",
    "dist/**/*.d.ts.map",
    "cordis.patch.yml"
  ],
  "scripts": {
    "build": "tsc --project tsconfig.lib.json",
    "format:check": "prettier --check package.json tsconfig*.json cordis.patch.yml src test",
    "lint": "eslint src test",
    "test": "vitest run",
    "typecheck": "tsc --project tsconfig.lib.json --noEmit"
  },
  "nx": {
    "tags": [
      "type:host"
    ]
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-agent": "0.1.1-rc.2",
    "@deepseek-ai/dsh-jobs": "0.1.1-rc.2",
    "@deepseek-ai/dsh-subagent": "^0.1.1-rc.2",
    "@deepseek-ai/dsh-tools": "^0.1.1-rc.2"
  },
  "dependencies": {
    "@big-plan/engine": "workspace:*",
    "@big-plan/repository-authority": "workspace:*"
  },
  "devDependencies": {
    "@deepseek-ai/dsh-agent": "0.1.1-rc.2",
    "@deepseek-ai/dsh-jobs": "0.1.1-rc.2"
  }
}
