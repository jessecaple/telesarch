{
  "name": "big-plan",
  "version": "0.0.0",
  "description": "Host-only DeepSeek Harness plugin for durable delivery coordination",
  "type": "module",
  "imports": {
    "#agent-contracts": "./src/orchestration/role-contracts/index.ts",
    "#code-context": "./src/context/code/index.ts",
    "#engine": "./src/delivery/index.ts",
    "#git": "./src/repository/git/index.ts",
    "#github": "./src/handoff/github/index.ts",
    "#repository-authority": "./src/persistence/authority/index.ts",
    "#repository-tooling": "./src/repository/tooling/index.ts",
    "#source-index": "./src/context/source-index/index.ts",
    "#sqlite": "./src/persistence/sqlite/index.ts"
  },
  "main": "./dist/index.js",
  "types": "./index.d.ts",
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "default": "./dist/index.js"
    },
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "dist/index.js",
    "dist/index.js.map",
    "index.d.ts",
    "contracts/**",
    "cordis.patch.yml"
  ],
  "scripts": {
    "build": "node scripts/build.mjs",
    "format:check": "prettier --check package.json tsconfig*.json cordis.patch.yml index.d.ts scripts src test contracts",
    "lint": "eslint src test",
    "test": "vitest run",
    "typecheck": "tsc --project tsconfig.lib.json --noEmit"
  },
  "nx": {
    "tags": [
      "type:host"
    ]
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-agent": "0.1.1-rc.2",
    "@deepseek-ai/dsh-jobs": "0.1.1-rc.2",
    "@deepseek-ai/dsh-subagent": "^0.1.1-rc.2",
    "@deepseek-ai/dsh-tools": "^0.1.1-rc.2"
  },
  "devDependencies": {
    "@deepseek-ai/dsh-agent": "0.1.1-rc.2",
    "@deepseek-ai/dsh-jobs": "0.1.1-rc.2",
    "@types/better-sqlite3": "9.6.0",
    "esbuild": "^0.28.2"
  },
  "dependencies": {
    "ajv": "8.20.0",
    "better-sqlite3": "catalog:",
    "typescript": "npm:@typescript/typescript6@~6.0.2"
  }
}
