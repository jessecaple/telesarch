{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "result": {
      "anyOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "properties": { "status": { "const": "leaf" } },
          "required": ["status"]
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "status": { "const": "children" },
            "children": {
              "type": "array",
              "minItems": 2,
              "items": { "$ref": "#/$defs/child" }
            },
            "dependencies": {
              "type": "array",
              "items": { "$ref": "#/$defs/dependency" }
            }
          },
          "required": ["status", "children", "dependencies"]
        }
      ]
    }
  },
  "required": ["result"],
  "$defs": {
    "strings": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    },
    "child": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "nodeId": { "type": "string", "minLength": 1 },
        "displayOrder": { "type": "integer", "minimum": 0 },
        "title": { "type": "string", "minLength": 1 },
        "goal": { "type": "string", "minLength": 1 },
        "provides": { "$ref": "#/$defs/strings" },
        "consumes": { "$ref": "#/$defs/strings" },
        "completionCriteria": { "$ref": "#/$defs/strings" },
        "notInScope": { "$ref": "#/$defs/strings" }
      },
      "required": [
        "nodeId",
        "displayOrder",
        "title",
        "goal",
        "provides",
        "consumes",
        "completionCriteria",
        "notInScope"
      ]
    },
    "dependency": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "nodeId": { "type": "string", "minLength": 1 },
        "dependencyNodeId": { "type": "string", "minLength": 1 }
      },
      "required": ["nodeId", "dependencyNodeId"]
    }
  }
}
