{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "properties": { "result": { "$ref": "#/$defs/review" } },
  "required": ["result"],
  "$defs": {
    "review": {
      "anyOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "properties": { "status": { "const": "accepted" } },
          "required": ["status"]
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "status": { "const": "findings" },
            "findings": {
              "type": "array",
              "minItems": 1,
              "items": { "type": "string", "minLength": 1 }
            }
          },
          "required": ["status", "findings"]
        }
      ]
    }
  }
}
