{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["result"],
  "properties": {
    "result": {
      "anyOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "properties": { "status": { "const": "preview-ready" } },
          "required": ["status"]
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "status": { "const": "revision-required" },
            "reason": { "type": "string", "minLength": 1 }
          },
          "required": ["status", "reason"]
        }
      ]
    }
  }
}
