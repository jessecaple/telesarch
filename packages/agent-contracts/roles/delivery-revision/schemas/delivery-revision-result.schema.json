{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "result": {
      "anyOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "status": { "const": "applied" },
            "graph": { "$ref": "#/$defs/graph" }
          },
          "required": ["status", "graph"]
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "status": { "const": "decision-required" },
            "question": { "type": "string", "minLength": 1 },
            "recommendation": { "type": "string", "minLength": 1 }
          },
          "required": ["status", "question"]
        }
      ]
    }
  },
  "required": ["result"],
  "$defs": {
    "strings": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    },
    "node": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "nodeId": { "type": "string", "minLength": 1 },
        "parentNodeId": { "type": "string", "minLength": 1 },
        "displayOrder": { "type": "integer", "minimum": 0 },
        "kind": { "enum": ["pending", "parent", "leaf"] },
        "state": {
          "enum": ["planned", "ready", "running", "waiting", "completed"]
        },
        "title": { "type": "string", "minLength": 1 },
        "goal": { "type": "string", "minLength": 1 },
        "provides": { "$ref": "#/$defs/strings" },
        "consumes": { "$ref": "#/$defs/strings" },
        "completionCriteria": { "$ref": "#/$defs/strings" },
        "notInScope": { "$ref": "#/$defs/strings" }
      },
      "required": [
        "nodeId",
        "displayOrder",
        "kind",
        "state",
        "title",
        "goal",
        "provides",
        "consumes",
        "completionCriteria",
        "notInScope"
      ]
    },
    "dependency": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "nodeId": { "type": "string", "minLength": 1 },
        "dependencyNodeId": { "type": "string", "minLength": 1 }
      },
      "required": ["nodeId", "dependencyNodeId"]
    },
    "graph": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "nodes": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/node" }
        },
        "dependencies": {
          "type": "array",
          "items": { "$ref": "#/$defs/dependency" }
        }
      },
      "required": ["nodes", "dependencies"]
    }
  }
}
